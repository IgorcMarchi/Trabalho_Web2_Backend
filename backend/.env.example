# Copie este arquivo para .env e preencha os valores.
# O .env NÃO vai para o Git; este .env.example vai, por isso não tem segredos.

# Porta da API
PORT=3001

# development (synchronize ligado, Swagger ligado) ou production
NODE_ENV=development

# Arquivo do banco SQLite. A pasta é criada automaticamente.
DB_PATH=./dados/tecshop.sqlite

# Segredo usado para assinar o JWT. Use um texto longo e aleatório
# (no mínimo 32 caracteres). Para gerar um:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# O front-end (Trabalho01-Web-main/.env.local) precisa do MESMO valor.
JWT_SECRET=19f74f10df05b5eee6a0438554ed8e601b70c9b88e9d2d4e2c3bd7ef9b9615c5637577e1c1a44c1648a2e5f55e885c8f

# Tempo de vida do token, sempre com a unidade (ex.: 1h, 30m, 3600s).
# Só o número seria lido como milissegundos, e a API não sobe.
JWT_EXPIRES_IN=1h

# Conta administrativa criada pelo seed (npm run seed).
# Defina a senha antes de rodar o seed; sem ela o admin não é criado.
# No banco vai só o hash da senha. Em produção o seed recusa admin123.
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@tecshop.com
ADMIN_PASSWORD=admin123

# Origem(ns) do front-end liberadas no CORS (separe várias por vírgula)
FRONTEND_URL=http://localhost:3000

# Documentação Swagger em /docs. Sem esta variável ela fica ligada em
# development e desligada em production. Descomente com true para ligar
# em production, ou com false para desligar em qualquer ambiente.
# SWAGGER_ENABLED=true
