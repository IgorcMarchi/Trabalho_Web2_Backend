# Copie para .env.local e preencha. O .env.local NÃO vai para o Git.
# Nenhuma variável aqui tem o prefixo NEXT_PUBLIC_: elas só existem no
# servidor do Next e nunca chegam ao navegador.

# Endereço da API NestJS (pasta backend)
API_URL=http://localhost:3001

# O MESMO valor de JWT_SECRET do backend/.env.
# O proxy.js usa para conferir a assinatura do token antes de abrir
# as páginas privadas.
JWT_SECRET=
